<?xml version="1.0"?>
<sdf version="1.8">
  <world name="corridor_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Gazebo systems -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-air-pressure-system" name="gz::sim::systems::AirPressure"/>
    <plugin filename="gz-sim-magnetometer-system" name="gz::sim::systems::Magnetometer"/>
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat"/>

    <!-- GPS origin so ArduPilot's EKF can start -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>-35.363262</latitude_deg>
      <longitude_deg>149.165237</longitude_deg>
      <elevation>584</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- Lighting (inline, no internet needed) -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- Ground (inline, no internet needed) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Drone: starts at the open end of the corridor -->
    <include>
      <uri>model://iris_with_ardupilot</uri>
      <pose>-7 0 0.1 0 0 0</pose>
    </include>

    <!-- Left wall (red) -->
    <model name="left_wall">
      <static>true</static>
      <pose>0 1.9 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>16.0 0.2 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>16.0 0.2 2.0</size></box></geometry>
          <material>
            <ambient>0.8 0.15 0.15 1</ambient>
            <diffuse>0.8 0.15 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- Right wall (blue) -->
    <model name="right_wall">
      <static>true</static>
      <pose>0 -1.9 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>16.0 0.2 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>16.0 0.2 2.0</size></box></geometry>
          <material>
            <ambient>0.15 0.2 0.8 1</ambient>
            <diffuse>0.15 0.2 0.8 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- End wall (yellow) -->
    <model name="end_wall">
      <static>true</static>
      <pose>8.1 0 1.0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 4.0 2.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 4.0 2.0</size></box></geometry>
          <material>
            <ambient>0.9 0.8 0.1 1</ambient>
            <diffuse>0.9 0.8 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
